# Build outputs (Xcode derived data, produced by the scripts under dm/ios)
.iosdd/
.iosdd_mac/
.iosdd_*/
.DS_Store
__pycache__/

# RomFS archives (generated from your own game files; never commit game data)
*.idx
romfs.[0-9][0-9]

# Swift Package build products and the packaged app (rebuild with `swift build -c release`)
frontend/.build/
frontend/NS Port Builder.app/

# Made from each shader build's Mac outputs (c1_guard.py, cb_extent.py; the NSP script makes them), not committed
dm/games/*/c1_full.tsv
dm/games/*/cb_extent.tsv

# Swift build products at the repository root (a stray build run)
.build/
sync.log
